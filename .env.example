# Firebase Web SDK config -- Firebase console > Project settings > Your apps > Web
# Copy to .env.local for local dev; set the same keys in your CI/build env for AWS.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Optional: pull the question bank from Firestore instead of the bundled fallback
VITE_USE_FIRESTORE_QUESTIONS=true

# Optional: restrict Google sign-in to one or more email domains.
# Empty (the default) accepts any Google account. Comma-separated for several.
# This is a UX gate -- see the commented rule in firestore.rules to enforce it
# server-side as well.
VITE_ALLOWED_EMAIL_DOMAINS=
